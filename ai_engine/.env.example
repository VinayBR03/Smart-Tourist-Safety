# =========================================================
# SERVICE
# =========================================================

SERVICE_NAME=sentinel_tour_ai_engine
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO


# =========================================================
# INTERNAL TOKEN
# Must exactly match INTERNAL_SERVICE_TOKEN in backend/.env.docker
# ← UPDATE: same value as backend INTERNAL_SERVICE_TOKEN
# Generate with: openssl rand -hex 32
# =========================================================

AI_ENGINE_INTERNAL_TOKEN=<YOUR_AI_ENGINE_INTERNAL_TOKEN>


# =========================================================
# BACKEND URL
# Used by retraining tasks to fetch training datasets via
# GET /internal/datasets/* endpoints on the backend.
# =========================================================

BACKEND_URL=http://backend:8000


# =========================================================
# MODEL CONFIG
# =========================================================

# Set True to reload models from artifacts/ on startup
# even if they were already loaded. Safe to leave False —
# lifespan always calls load_all() on startup anyway.
MODEL_AUTO_RELOAD=False
