                    ]
                },
                "index.tsx",
                {
                    "profile": [
                        "index.tsx"
                    ]
                },
                {
                    "settings": [
                        "index.tsx"
                    ]
                }
            ]
        },
        "app.json",
        "app.zip",
        {
            "assets": [
                "adaptive-foreground.png",
                "adaptive-icon.png",
                "favicon.png",
                "icon.png",
                "logo-512.png",
                "logo.png",
                "notification-icon.png",
                "splash-icon.png"
            ]
        },
        "babel.config.js",
        "create.py",
