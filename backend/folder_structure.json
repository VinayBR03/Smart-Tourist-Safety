                    ]
                },
                {
                    "hooks": [
                        "useAuth.ts",
                        "useBluetooth.ts",
                        "useHealth.ts",
                        "useIncidents.ts",
                        "useLocation.ts",
                        "useNotifications.ts",
                        "useTheme.ts",
                        "useZones.ts"
                    ]
                },
                {
                    "services": [
                        "bluetoothService.ts",
                        "locationService.ts"
                    ]
                },
                {
                    "store": [
                        "authStore.ts",
                        "deviceStore.ts",
                        "notificationStore.ts",
                        "themeStore.ts"
                    ]
                },
                {
                    "types": [
                        "api.ts",
                        "auth.ts",
                        "health.ts"
                    ]
                },
                {
                    "utils": [
                        "i18n.ts",
                        "storage.ts",
                        "themedStyles.ts",
                        "websocket.ts"
                    ]
