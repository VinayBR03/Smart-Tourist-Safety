                {
                    "(auth)": [
                        "language-select.tsx",
                        "login.tsx",
                        "register.tsx"
                    ]
                },
                {
                    "(tabs)": [
                        "health.tsx",
                        "index.tsx",
                        "map.tsx",
                        "notifications.tsx",
                        "sos.tsx"
                    ]
                },
                {
                    "devices": [
                        "index.tsx"
                    ]
                },
                {
                    "incidents": [
                        "[id].tsx",
