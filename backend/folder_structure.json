                        "zones.ts"
                    ]
                },
                {
                    "components": [
                        {
                            "layout": [
                                "Header.tsx",
                                "ScreenWrapper.tsx",
                                "ThemedView.tsx"
                            ]
                        },
                        {
                            "map": [
                                "MapSearchBar.tsx",
                                "ZoneOverlay.tsx"
                            ]
                        },
                        {
                            "ui": [
                                "Avatar.tsx",
                                "Badge.tsx",
                                "Button.tsx",
                                "Card.tsx",
                                "HealthMetricCard.tsx",
                                "Icons.tsx"
