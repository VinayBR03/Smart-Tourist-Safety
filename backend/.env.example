# =========================================================
# APPLICATION
# =========================================================
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Sentinel Tour
ALLOWED_ORIGINS=http://localhost:3000

# =========================================================
# DATABASE
# =========================================================
DATABASE_URL=postgresql+psycopg2://db_user:db_password@localhost:5432/db_name
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=5000

# =========================================================
# INTERNAL
# =========================================================
INTERNAL_SERVICE_TOKEN=<YOUR_INTERNAL_SERVICE_TOKEN>

# =========================================================
# FEATURE TOGGLES
# =========================================================
ENABLE_REDIS=True
ENABLE_KAFKA=True
ENABLE_CELERY=True
ENABLE_S3=True
ENABLE_PUSH=True
ENABLE_SMS=True
ENABLE_RATE_LIMITER=True
ENABLE_WEBSOCKETS=True

# =========================================================
# ML ENGINE
# =========================================================
ML_ENGINE_ENABLED=True
ML_ENGINE_URL=http://localhost:8001
ML_ENGINE_TIMEOUT_SECONDS=3

# =========================================================
# S3
# =========================================================
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_REGION=<YOUR_NEAREST_AWS_REGION>
AWS_S3_BUCKET=<YOUR_AWS_S3_BUCKET>

# =========================================================
# PUSH NOTIFICATIONS
# =========================================================
FCM_PROJECT_ID=<YOUR_FCM_PROJECT_ID>
FCM_SERVICE_ACCOUNT_JSON=<YOUR_FCM_SERVICE_ACCOUNT_JSON>

# =========================================================
# TWILIO SMS
# =========================================================
TWILIO_ACCOUNT_SID=<YOUR_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<YOUR_TWILIO_PHONE_NUMBER>

# =========================================================
# RISK ENGINE
# =========================================================
RISK_INCIDENT_WEIGHT=0.5
RISK_SOS_WEIGHT=0.3
RISK_DENSITY_WEIGHT=0.2
RISK_DENSITY_NORMALIZER=50

# =========================================================
# INCIDENT CONFIG
# =========================================================
INCIDENT_SLA_MINUTES=30
INCIDENT_AUTO_CLOSE_DAYS=7

# =========================================================
# JWT
# =========================================================
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY>
JWT_REFRESH_SECRET_KEY=<YOUR_JWT_REFRESH_SECRET_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ROTATION_ENABLED=True

# =========================================================
# SECURITY
# =========================================================
BCRYPT_ROUNDS=12

# =========================================================
# EMAIL
# =========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_USER>
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_FROM=<YOUR_SMTP_FROM>
SMTP_USE_TLS=True

# =========================================================
# REDIS
# =========================================================
# Dev: localhost | Docker: use redis service name (e.g., redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=False

# =========================================================
# CELERY
# =========================================================
# Format: redis://[password]@[host]:[port]/[db_index]
# Dev: localhost | Docker: use redis service name (e.g., redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# =========================================================
# KAFKA
# =========================================================
# Dev: localhost:9092 | Docker: use kafka service name and internal port
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# =========================================================
# ACCOUNT LIFECYCLE
# =========================================================
ACCOUNT_DELETION_ENABLED=True
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_DELETION_BATCH_SIZE=100

# =========================================================
# DEVICE CONFIG
# =========================================================
DEVICE_HEARTBEAT_RATE_LIMIT=120
LOW_BATTERY_THRESHOLD=20
DEVICE_ALERT_COOLDOWN_MINUTES=30
DEVICE_OFFLINE_THRESHOLD_MINUTES=5

# =========================================================
# GEOFENCE CONFIG
# =========================================================
DEFAULT_ZONE_PROXIMITY_RADIUS=50
MAX_ZONE_PROXIMITY_RADIUS=500

# =========================================================
# HEALTH MONITOR CONFIG
# =========================================================
HEALTH_ALERT_COOLDOWN_MINUTES=10
HEART_RATE_HIGH=130
HEART_RATE_LOW=40
SPO2_LOW=92
TEMP_HIGH=38.5
