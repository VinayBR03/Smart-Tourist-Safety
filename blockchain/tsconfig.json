{
  "compilerOptions": {
    "lib": ["es2020"],
    "module": "nodenext",
    "target": "es2020",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["scripts/**/*", "hardhat.config.ts"]
}